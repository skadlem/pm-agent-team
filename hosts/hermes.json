{
  "name": "hermes",
  "display_name": "Hermes Agent",
  "template_root_file": "~/.hermes/pmos-template-root",
  "skills_dir": "~/.hermes/skills",
  "agents_dir": "~/.hermes/agents",
  "defaults_file": "~/.hermes/pmos-team-defaults.json",
  "spawn": {
    "doc": "delegate_task: spawn a subagent with an explicit model and effort",
    "command": "delegate_task(goal=..., model=<model>, effort=<effort>)",
    "model_flag": "model=<model>",
    "effort_flag": "effort=<effort>"
  },
  "list_models": "hermes models (configured providers)",
  "usage": {
    "doc": "token counts come from the subagent result (usage block)"
  },
  "tool_rewrites": [
    {"from": "`swarm` tool", "to": "`delegate_task` subagent"},
    {"from": "`swarm list_models`", "to": "the configured provider/model list"},
    {"from": "`model` in the swarm", "to": "`model=` in delegate_task"},
    {"from": "the swarm result", "to": "the subagent result"},
    {"from": "~/.jcode/pmos-template-root", "to": "~/.hermes/pmos-template-root"},
    {"from": "~/.jcode/pmos-team-defaults.json", "to": "~/.hermes/pmos-team-defaults.json"},
    {"from": "swarm default", "to": "hermes default"}
  ],
  "suppressed": ["gstack"],
  "file_scope_hooks": {
    "available": false,
    "doc": "no file-scope edit hooks today; do-not-touch is enforced at the checkpoint (trace.py unplanned), not at edit time"
  }
}
